# Spotify Developer App Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# ── Local play ────────────────────────────────────────────────────────────────
# Use 127.0.0.1 (not localhost) — Spotify no longer accepts localhost redirects
BASE_URL=http://127.0.0.1:3000
PORT=3000

# ── Railway deployment ────────────────────────────────────────────────────────
# Set these as environment variables in Railway dashboard, not here
# BASE_URL=https://your-app.railway.app
# REDIS_URL is set automatically when you add the Redis plugin in Railway

# ── Local HTTPS (LAN play with friends) ──────────────────────────────────────
# BASE_URL=https://YOUR_LOCAL_IP:3443

# Game settings
WIN_SCORE=10
